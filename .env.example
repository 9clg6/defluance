# Copy to .env. Keep it out of version control.

# Required
POSTGRES_PASSWORD=change-me
DFL_SESSION_SECRET=generate-with-openssl-rand-hex-32
DFL_ADMIN_TOKEN=dfl_generate-with-openssl-rand-hex-24

# Where the Markdown notes live on the host (a git repository, or an empty folder)
VAULT_PATH=./vault

# Public address, used for links in GitHub issues and OAuth callbacks
DFL_PUBLIC_URL=http://localhost:4000
# DOMAIN=specs.example.com        # only for: docker compose --profile tls up -d

# Search and answers. `hash` works offline; use a real embedding model for meaning-based search.
DFL_EMBED=hash
# DFL_EMBED=ollama:nomic-embed-text      (needs OLLAMA_BASE_URL=http://host.docker.internal:11434/v1)
# DFL_EMBED=openai:text-embedding-3-small
DFL_LLM=
# DFL_LLM=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# People: GitHub sign-in (optional) and who is admin
DFL_ADMINS=
DFL_DEFAULT_ROLE=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# GitHub connector (optional): see Settings > GitHub in the app
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
