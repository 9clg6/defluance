#!/usr/bin/env bash
# Store a secret in /opt/defluance/.env from standard input, then restart Defluance.
# The value is read from stdin, so it never appears in a command line, a log or a shell history:
#   pbpaste | ssh root@HOST /opt/defluance/set-secret OPENROUTER_API_KEY
# A multi-line value (a PEM private key) is stored on one line with `\n`, as the server expects.
set -euo pipefail
name=${1:?usage: set-secret NAME < value}
[[ $name =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "NAME must be upper case letters, digits and _" >&2; exit 2; }
cd "$(dirname "$0")"
value=$(cat | tr -d '\r' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
[ -n "$value" ] || { echo "empty value: nothing stored" >&2; exit 2; }
one=$(printf '%s' "$value" | awk 'BEGIN{ORS="\\n"} {print}' | sed 's/\\n$//')
umask 077
tmp=$(mktemp .env.XXXXXX)
grep -v "^$name=" .env > "$tmp" || true
printf '%s=%s\n' "$name" "$one" >> "$tmp"
if [ "$name" = OPENROUTER_API_KEY ] && ! grep -q '^DFL_LLM=' "$tmp"; then
  echo 'DFL_LLM=openrouter:anthropic/claude-sonnet-5.5' >> "$tmp"
fi
mv "$tmp" .env
docker compose up -d defluance >/dev/null 2>&1
echo "$name stored ($(printf '%s' "$value" | wc -c | tr -d ' ') characters), Defluance restarted"
